# The library's layout; `tools/check-format.sh` checks it.
# Use the version CI uses (`pipx install clang-format==23.1.3`): another version may format differently.
# The oldest that reads this file is 22 (the BreakAfterOpenBracket* options).
BasedOnStyle: Google
Language: Cpp
Standard: c++17
ColumnLimit: 120
IndentWidth: 2
ContinuationIndentWidth: 2
AccessModifierOffset: -2

# No visual alignment: a continuation indents 2, never to a column taken from the line above.
# Break after an open bracket and close it on its own line, in calls, declarations, braced lists and conditions.
AlignAfterOpenBracket: false
AlignOperands: DontAlign
AlignTrailingComments:
  Kind: Never
AlignEscapedNewlines: DontAlign
BreakAfterOpenBracketFunction: true
BreakBeforeCloseBracketFunction: true
BreakAfterOpenBracketIf: true
BreakBeforeCloseBracketIf: true
BreakAfterOpenBracketLoop: true
BreakBeforeCloseBracketLoop: true
BreakAfterOpenBracketSwitch: true
BreakBeforeCloseBracketSwitch: true
BreakAfterOpenBracketBracedList: true
BreakBeforeCloseBracketBracedList: true
BreakBeforeTemplateCloser: true
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: false

# Keep lambda captures, stream chains and ternary branches on 2-space steps.
# The other two stop the breaks this would otherwise prefer: a return type alone on a line, and a break after `::`.
PenaltyIndentedWhitespace: 150
PenaltyBreakScopeResolution: 10000
PenaltyReturnTypeOnItsOwnLine: 1000
# Break inside a call's brackets rather than before a member access, which would hang at +4.
PenaltyBreakBeforeMemberAccess: 1000

# Constructor initializers: the colon at the function's indent.
BreakConstructorInitializers: BeforeColon
ConstructorInitializerIndentWidth: 0
PackConstructorInitializers: NextLine

# Braces always, and every non-empty body on its own lines: functions, lambdas, if, loops, cases.
InsertBraces: true
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: Empty
AllowShortLambdasOnASingleLine: Empty

# `const auto`, `T* p`, `T& r`.
QualifierAlignment: Left
DerivePointerAlignment: false
PointerAlignment: Left

# Comments are written one sentence per line; never rewrap them.
ReflowComments: Never
SpacesBeforeTrailingComments: 1

# A message stays one literal, so it can be found by grep.
BreakStringLiterals: false

# Keep the include groups as written; sort within each group.
IncludeBlocks: Preserve
