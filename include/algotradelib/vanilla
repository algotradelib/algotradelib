#pragma once

/**
 * @file
 * @brief The strategies this library ships (`algotradelib::strategy::vanilla`).
 *
 * Each states the holding it wants (a target position, or for `EqualWeightRebalance` a target
 * weight) rather than a quantity to trade, so after a restart it does not need to remember whether it
 * already entered: reconciliation compares it with the portfolio and the working orders. Each states its warm-up requirement and emits nothing before it is met.
 *
 * `BuyAndHold` and `TimedLiquidation` read no series and are available in every build; the rest sit
 * in headers that include `<algotradelib/analytics>`, and so need a linear-algebra backend.
 */

#include "src/strategy/vanilla/buy_and_hold.hpp"
#include "src/strategy/vanilla/timed_liquidation.hpp"

#if defined(ATL_HAS_EIGEN)
#include "src/strategy/vanilla/crossover.hpp"
#include "src/strategy/vanilla/reversion.hpp"
#include "src/strategy/vanilla/signal.hpp"
#include "src/strategy/vanilla/sizing.hpp"
#endif

#include <algotradelib/strategy>
