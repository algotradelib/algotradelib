#pragma once

/**
 * Replaying history through the same context a live session uses.
 *
 * The third runner over `Runner::feed()`, after `DryRunner` and the session-backed one. A strategy's
 * source is identical in all three, which is what the shape settled in `strategy-core` was for.
 *
 * **Nothing here assumes a bar is a day.** Neither supported broker makes intraday history easy, but
 * that is a limitation of two adapters rather than a property of backtesting, and a caller with minute
 * bars must be able to replay them without the engine being rewritten. The clock advances by a bar's
 * own period end, phases are derived from a session window, and the period count an annualized figure
 * needs is stated rather than assumed.
 *
 * Reaches no broker and no transport: a backtest touches nothing.
 */

#include "src/backtest/clock.hpp"
#include "src/backtest/cost.hpp"
#include "src/backtest/fill.hpp"
#include "src/backtest/ledger.hpp"

#include <algotradelib/runner>
