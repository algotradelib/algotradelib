#pragma once

/**
 * @file
 * @brief The machinery that runs a strategy, without a broker: the context a strategy reads, the
 *   dispatcher, `Runner` and `DryRunner`, the polling loop (`PollingLoop`, its clock and stop
 *   controls) and the order journal.
 *
 * Includes no broker or transport header: a dry-run program compiles no call into TLS or HTTP and
 * instantiates no adapter (checked by the library's tests). The link line still carries OpenSSL,
 * because the package exports one target for every consumer. `SessionSource`, which fetches from a
 * broker, is in `<algotradelib/live>`.
 *
 * With a linear-algebra backend it also includes `<algotradelib/analytics>`, for the cached bar
 * series; without one the context has no series accessors.
 */

#include "src/runner/clock.hpp"
#include "src/runner/context.hpp"
#include "src/runner/dispatch.hpp"
#include "src/runner/runner.hpp"
#include "src/runner/execution.hpp"
#include "src/runner/file_journal.hpp"
#include "src/runner/journal.hpp"
#include "src/runner/loop.hpp"
#include "src/runner/reconcile_orders.hpp"
#include "src/runner/signal_stop.hpp"
#include "src/runner/stop.hpp"

#include <algotradelib/strategy>
